{
  "name": "dsh-puppet-memory",
  "version": "0.30.0-dev",
  "description": "木偶记忆（Puppet Memory）：DSH 跨会话记忆插件。三层记忆（行为/深层/阵列）+ 600 字常驻核心卡 + 三线状态（工作/陪伴/学习）+ 多人多群记忆（身份归一、分区可见性、按场景注入）+ 会话级记忆管理（屏蔽/删除脏片段）+ 自动摘要与事实候选 + 小模型路由 + 家目录备份与自检。零依赖、纯文本、MIT。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "social.js",
    "state.js",
    "sessionmem.js",
    "cordis.patch.yml",
    "README.md",
    "icon.png",
    "怎么用-给大肥鱼.md",
    "给人类的说明书.md",
    "前辈经验.md",
    "便签.txt",
    "全功能说明.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "displayName": "木偶记忆",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "puppet"
  ],
  "icon": "./icon.png"
}
