{
  "name": "dsh-puppet-memory",
  "version": "0.51.1",
  "description": "木偶记忆：给 DSH 的本地跨会话记忆。三张卡（核心/规则/状态，400/400/300 字）+ 人设骨架 + 关系按人名提示 + 记录册（主词｜副词｜状态）+ 日记与自动摘要 + 会话级屏蔽与删除 + 家目录备份与自检。纯文本、零依赖、MIT。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "learn.js",
    "conflict.js",
    "lorebook.js",
    "agreement-watch.js",
    "agreement-judge.js",
    "opening-autorecord.js",
    "circle.js",
    "rules.js",
    "grants.js",
    "self-layer.js",
    "searchindex.js",
    "cueprompt.js",
    "words.js",
    "dayspan.js",
    "words-dict.json",
    "cloudbackup.js",
    "client.js",
    "social.js",
    "state.js",
    "people.js",
    "update-check.js",
    "persona-hint.js",
    "session-decode.js",
    "session-digest.js",
    "session-pool.js",
    "session-pool-judge.js",
    "knowledge.js",
    "sessionmem.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "抢修卡.md",
    "icon.png",
    "AI-安装指令.md",
    "给人类的说明书.md",
    "前辈经验.md",
    "全功能说明.md",
    "验收-A测-修补目录.md",
    "self-promote.js",
    "例句-大肥鱼说话.md",
    "docs/*.md",
    "验收-B测-待办.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1"
  },
  "license": "MIT",
  "displayName": "木偶记忆",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "puppet"
  ],
  "icon": "./icon.png",
  "scripts": {
    "check:privacy": "node 脱敏检查.mjs",
    "test": "node test/smoke.mjs && node test/update-check.mjs && node test/update-api.mjs && node test/update-client.mjs && node test/backup-client.mjs"
  }
}
