{
  "name": "dsh-puppet-memory",
  "version": "0.39.0",
  "description": "木偶记忆（Puppet Memory）：DSH 跨会话记忆插件。记忆按用途分五层（常驻/按需·行为/按需·知识/账本/临时）+ 三张常驻卡（600/800/400 字） + 三线状态（工作/陪伴/学习）+ 多人多群记忆（身份归一、分区可见性、按场景注入）+ 会话级记忆管理（屏蔽/删除脏片段）+ 自动摘要与事实候选 + 小模型路由 + 家目录备份与自检 + 值班台（QQ/B站/记忆心跳一屏）+ 标废/别名/导出档案/日记全文可选。零依赖、纯文本、MIT。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "rules.js",
    "searchindex.js",
    "cueprompt.js",
    "words.js",
    "words-dict.json",
    "cloudbackup.js",
    "client.js",
    "social.js",
    "state.js",
    "sessionmem.js",
    "cordis.patch.yml",
    "README.md",
    "icon.png",
    "AI-安装指令.md",
    "给人类的说明书.md",
    "前辈经验.md",
    "全功能说明.md",
    "验收-A测-修补目录.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "license": "MIT",
  "displayName": "木偶记忆",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "puppet"
  ],
  "icon": "./icon.png",
  "scripts": {
    "check:privacy": "node 脱敏检查.mjs",
    "test": "node test/smoke.mjs"
  }
}
